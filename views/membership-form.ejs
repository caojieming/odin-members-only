<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- set styling file -->
  <link rel="stylesheet" href="/css/base.css">
  <title>Change Membership Status</title>
</head>
<body>
  <%- include("./partials/header") %>
  <main>

    <a href="/">Go back home</a>

    <% if (locals.currentUser) {%>
      <h1>Currently logged in as <%= currentUser.username %></h1>
      <p>Current membership status: <%= currentUser.membership %></p>
      <h2>Please input the super secret code to the membership level you wish to change to.</h2>
      <%- include("./partials/errors") %>
      <form action="/membership-form" method="POST">
        <label for="membership_code">Secret Code</label>
        <input id="membership_code" name="membership_code" placeholder="membership code" type="text" required/>
        <button type="submit">Submit</button>
      </form>
    <% }
    else { %>
      <h1>Please go back to home and log in first before trying to change membership status.</h1>
    <%}%>

  </main>
  <%- include("./partials/footer") %>
</body>
</html>