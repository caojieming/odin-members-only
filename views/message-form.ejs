<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- set styling file -->
  <link rel="stylesheet" href="/css/base.css">
  <title>Create new message</title>
</head>
<body>
  <%- include('./partials/header') %>
  <main>

    <% if (locals.currentUser) {%>
      <h1>Create a new message!</h1>
      <%- include("./partials/errors") %>
      <form action="/message-form" method="POST">
        <div class="form-section">
          <label for="title">Message title</label>
          <input id="title" name="title" placeholder="title" type="text" required/>
        </div>
        <div class="form-section">
          <label for="body">Message body</label>
          <input id="body" name="body" placeholder="message body text" type="text" required/>
        </div>
        <button type="submit">Submit</button>
      </form>
    <% } else { %>
      <h1>Please go back to home and log in first before trying to create a new message.</h1>
    <%}%>

  </main>
  <%- include('./partials/footer') %>
</body>
</html>