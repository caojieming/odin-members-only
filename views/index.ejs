<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- set styling file -->
  <link rel="stylesheet" href="/css/base.css">
  <title>Home/Login</title>
</head>
<body>
  <%- include('./partials/header') %>
  <main>

    <% if (locals.currentUser) {%>
      <h1>WELCOME BACK <%= currentUser.name %>, AKA <%= currentUser.username %></h1>
      <p>Current membership status: <%= currentUser.membership %></p>
      <a href="/membership-form">Change membership status!</a>
      <a href="/log-out">LOG OUT</a>

      <section id="messages">
        <a href="/message-form">Create a new message!</a>
        <div class="list">
          <% for (let i = 0; i < messages.length; i++) { 
            curMsg = messages[i]; %>
            <div class="message">
              <p><%= `Title: ${curMsg.title}` %></p>
              <p><%= `Author: ${curMsg.author_id}` %></p>
              <p><%= `Posted: ${curMsg.created_at}` %></p>
              <p><%= `Body Text: ${curMsg.body}` %></p>
            </div>
          <% } %>
        </div>
      </section>
    <% } else { %>
      <a href="/sign-up">sign up here!</a>
      <h1>Please log in</h1>
      <%- include("./partials/errors") %>
      <%- include("./partials/log-in") %>
    <%}%>

  </main>
  <%- include('./partials/footer') %>
</body>
</html>